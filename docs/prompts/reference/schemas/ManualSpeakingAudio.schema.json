          "type": "string"
        },
        "subtype": {
          "title": "Subtype",
          "type": "string"
        },
        "original": {
          "title": "Original",
          "type": "string"
        },
        "corrected": {
          "title": "Corrected",
          "type": "string"
        },
        "explanation_vi": {
          "title": "Explanation Vi",
          "type": "string"
        },
        "severity": {
          "enum": [
            "minor",
            "major",
            "critical"
