          "title": "Type",
          "type": "string"
        },
        "target": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "description_vi": {
          "maxLength": 1500,
          "minLength": 10,
          "title": "Description Vi",
          "type": "string"
        },
        "suggestion_vi": {
          "maxLength": 1500,
          "minLength": 10,
