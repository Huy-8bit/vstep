          "title": "Original",
          "type": "string"
        },
        "corrected": {
          "title": "Corrected",
          "type": "string"
        },
        "explanation_vi": {
          "title": "Explanation Vi",
          "type": "string"
        },
        "start_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
