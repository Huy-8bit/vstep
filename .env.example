APP_ENV=development
DATABASE_URL=postgresql+asyncpg://vstep:vstep_dev@localhost:5432/vstep
POSTGRES_USER=vstep
POSTGRES_PASSWORD=vstep_dev
POSTGRES_DB=vstep
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Set an audio-input Chat Completions model, e.g. gpt-audio, to assess pronunciation/fluency.
OPENAI_SPEAKING_AUDIO_MODEL=
# Optional: empty uses browser SpeechSynthesis for question playback.
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=alloy
AUDIO_STORAGE_DIR=data/audio
MAX_SPEAKING_AUDIO_MB=20
MAX_SPEAKING_AUDIO_SECONDS=360
JWT_SECRET=local-development-secret-change-before-production-2026
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://localhost:8000

# Minimum confidence for audio-derived diagnoses; IPA requires >=0.9.
PRONUNCIATION_CONFIDENCE_THRESHOLD=0.75
