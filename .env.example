APP_ENV=development
DATABASE_URL=postgresql+asyncpg://vstep:vstep_dev@localhost:5432/vstep
POSTGRES_USER=vstep
POSTGRES_PASSWORD=vstep_dev
POSTGRES_DB=vstep
OPENAI_API_KEY=

# Selected on the internal calibration dataset: see MODEL_EVALUATION.md for limits.
# Legacy OPENAI_MODEL does not override these.
MODEL_VERSION=2026-09-19-routing-v2
OPENAI_MODEL_DEFAULT=gpt-5.6-luna
OPENAI_MODEL_QUESTION_GENERATION=gpt-5.6-luna
OPENAI_MODEL_READING_GENERATION=gpt-5.6-luna
OPENAI_MODEL_QUESTION_QUALITY=gpt-5.4-mini-2026-03-17
OPENAI_MODEL_WRITING_ANALYSIS=gpt-5.6-luna
OPENAI_MODEL_WRITING_SCORING=gpt-5.6-luna
OPENAI_MODEL_WRITING_ESCALATION=gpt-5.6-terra
OPENAI_MODEL_WRITING_CORRECTIONS=gpt-5.4-mini-2026-03-17
OPENAI_MODEL_VOCABULARY=gpt-5.6-luna
OPENAI_MODEL_LEARNING_COACH=gpt-5.6-luna
OPENAI_MODEL_EXERCISE_GENERATOR=gpt-5.6-luna
OPENAI_MODEL_SPEAKING_TEXT_GRADING=gpt-5.4-mini-2026-03-17
OPENAI_MODEL_SPEAKING_ESCALATION=gpt-5.6-terra
OPENAI_MODEL_IMPORT=gpt-5.4-mini-2026-03-17
OPENAI_REASONING_DEFAULT=low
OPENAI_REASONING_GRADING=low
OPENAI_REASONING_WRITING=medium
OPENAI_REASONING_ESCALATION=none
GRADING_ESCALATION_ENABLED=true
GRADING_CONFIDENCE_THRESHOLD=0.70
GRADING_BOUNDARY_CONFIDENCE_THRESHOLD=0.80
GRADING_LONG_RESPONSE_WORDS=650
GRADING_SHADOW_ENABLED=false
GRADING_SHADOW_SAMPLE_RATE=0.05
EVAL_OVERALL_MAE_MAX=0.5
EVAL_CRITERION_MAE_MAX=0.75
EVAL_WITHIN_HALF_MIN=0.70
EVAL_WITHIN_ONE_MIN=0.90
EVAL_SERIOUS_OVERSCORE_MAX=0.02
EVAL_STRUCTURED_SUCCESS_MIN=0.99
EVAL_MIN_SAMPLES=12
AI_COST_ADMIN_EMAILS=
# Optional JSON maps for per-operation reasoning and per-model USD/1M token prices.
# OPENAI_REASONING_OVERRIDES={"writing_core":"medium","writing_calibration":"medium"}
# OPENAI_PRICE_OVERRIDES={"custom-model":{"input":1,"cached":0.1,"output":5}}
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Must support actual audio input and function calling in Chat Completions.
OPENAI_AUDIO_MODEL=gpt-audio
AUDIO_ANALYSIS_ENABLED=true
AUDIO_FEEDBACK_MIN_CONFIDENCE=0.70
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
AUDIO_STORAGE_DIR=data/audio
SPEAKING_AUDIO_MAX_MB=20
SPEAKING_AUDIO_MAX_SECONDS=360
# Optional for models supporting temperature; omit for reasoning models without it.
# OPENAI_GRADING_TEMPERATURE=0
# Comma-separated authenticated admin emails for the internal Writing inspection route.
WRITING_CALIBRATION_ADMIN_EMAILS=
JWT_SECRET=local-development-secret-change-before-production-2026
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://localhost:8000


# Product timing and spaced review heuristics
SPEAKING_PART1_SECONDS=180
SPEAKING_PART2_SECONDS=240
SPEAKING_PART3_SECONDS=300
VOCABULARY_REVIEW_DAYS=1,3,7,14,30

# Personalized learning heuristics (not official exam scoring)
LEARNING_OBSERVED_ATTEMPTS=2
LEARNING_RECURRING_ATTEMPTS=3
LEARNING_RECENCY_HALF_LIFE_DAYS=30
LEARNING_TREND_WINDOW=5
LEARNING_TREND_DELTA=0.2
LEARNING_MASTERY_EXERCISES=20
LEARNING_MASTERY_SESSIONS=3
LEARNING_MASTERY_REUSES=3
